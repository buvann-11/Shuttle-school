    {
      "id": "grip",
      "level": "Foundations",
      "title": "Grips",
      "kind": "grip",
      "summary": "Hold the racket loosely, like a handshake. A quarter turn switches forehand to backhand.",
      "keys": [
        {
          "label": "Forehand grip",
          "cue": "Shake hands with the handle",
          "grip": "forehand",
          "duration": 0
        },
        {
          "label": "Backhand thumb grip",
          "cue": "Quarter turn, thumb flat on the wide bevel",
          "grip": "backhand",
          "duration": 900
        },
        {
          "label": "Forehand grip",
          "cue": "Turn back for forehand shots",
          "grip": "forehand",
          "duration": 900
        }
      ],
      "points": [
        "Hold near the end of the handle, with a gap under the palm.",
        "Forehand: the V of thumb and index finger sits on the narrow upper-left bevel (right-handers).",
        "Backhand: quarter turn, thumb pad flat on the wide back bevel.",
        "Grip loosely. Squeeze only at contact."
      ],
      "mistakes": [
        "Frying-pan grip (face to the ceiling). It locks the wrist.",
        "Squeezing all rally long. Your forearm tires.",
        "Holding high up the shaft. You lose reach."
      ],
      "drill": "Switch forehand → backhand → forehand 30 times without looking. Then bounce the shuttle on the racket 20 times each side."
    },
